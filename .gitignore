# -------------------------------------------------------------------------
# DOCKER & SECRETS
# -------------------------------------------------------------------------
# Local database data generated by PostgreSQL container
/db_data/
/pgdata/

# Environment variables containing secrets, passwords, or API keys
*.env
.env.*
!.env.example

# -------------------------------------------------------------------------
# BACKEND (Spring Boot / Java / Maven)
# -------------------------------------------------------------------------
# Compiled class files and build directories
/backend/target/
*.class
*.jar
*.war

# Log files
*.log

# -------------------------------------------------------------------------
# FRONTEND (React / Vite)
# -------------------------------------------------------------------------
# Node modules (Dependencies)
/frontend/node_modules/

# Production build output
/frontend/dist/
/frontend/dist-ssr/

# Error logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -------------------------------------------------------------------------
# IDE & OPERATING SYSTEM
# -------------------------------------------------------------------------
# Visual Studio Code settings and local history
.vscode/
*.code-workspace

# macOS and Windows system files
.DS_Store
Thumbs.db