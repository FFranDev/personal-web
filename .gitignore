# -------------------------------------------------------------------------
# DOCKER & SECRETS
# -------------------------------------------------------------------------
# Local database and media data
/db_data/
/pgdata/
**/uploads/

# Environment variables containing secrets, passwords, or API keys
.env
*.env
.env.*
!.env.example

# -------------------------------------------------------------------------
# BACKEND (Spring Boot / Java / Maven)
# -------------------------------------------------------------------------
# Compiled class files and build directories
/backend/target/
*.class
*.jar
*.war
*.ear
!**/.mvn/wrapper/maven-wrapper.jar

# Log files
*.log

# -------------------------------------------------------------------------
# FRONTEND (React / Vite)
# -------------------------------------------------------------------------
# Node modules (Dependencies)
/frontend/node_modules/

# Production build output
/frontend/dist/
/frontend/dist-ssr/
*.local

# Error logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -------------------------------------------------------------------------
# IDE & OPERATING SYSTEM
# -------------------------------------------------------------------------
.vscode/
.idea/
*.iml
*.code-workspace

# macOS and Windows system files
.DS_Store
Thumbs.db